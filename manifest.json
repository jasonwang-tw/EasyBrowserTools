{
  "manifest_version": 3,
  "name": "Easy Browser Tools",
  "version": "1.0.0",
  "description": "選取網頁文字即可翻譯，支援原文與譯文複製、朗讀及右鍵翻譯。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "翻譯目前選取的文字",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/translate-popup.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
