{
  "manifest_version": 3,
  "name": "Easy Browser Tools",
  "version": "1.2.10",
  "description": "選取翻譯、自訂快捷鍵框選截圖，彈窗標註、圖片複製與本機 OCR。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://translate.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "選取文字翻譯；未選取時框選截圖",
    "default_icon": {
      "16": "icons/easy-browser-tools-yellow-16.png",
      "32": "icons/easy-browser-tools-yellow-32.png",
      "48": "icons/easy-browser-tools-yellow-48.png",
      "128": "icons/easy-browser-tools-yellow-128.png"
    }
  },
  "icons": {
    "16": "icons/easy-browser-tools-yellow-16.png",
    "32": "icons/easy-browser-tools-yellow-32.png",
    "48": "icons/easy-browser-tools-yellow-48.png",
    "128": "icons/easy-browser-tools-yellow-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/translate-popup.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/ocr-target.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://translate.google.com"
  },
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "框選截圖並開啟標註／OCR 彈窗"
    }
  }
}
